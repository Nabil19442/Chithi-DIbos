# =========================================================================
# Chithi Dibosh - Environment Configuration (.env)
# =========================================================================

# 1. Supabase Database Configuration
# Find these in your Supabase Project: Project Settings > API
SUPABASE_URL="https://your-project-id.supabase.co"
SUPABASE_ANON_KEY="your-supabase-anon-public-key"
SUPABASE_SERVICE_ROLE_KEY="your-supabase-service-role-secret-key"

# 2. Admin Authentication Credentials
# Username/Email and secure password for logging into /admin/login
ADMIN_USERNAME="admin"
ADMIN_PASSWORD="your-strong-custom-password-here"

# 3. Session Signing Secret (HMAC-SHA256)
# Generate any long random string for securing admin auth tokens
ADMIN_AUTH_SECRET="your-long-secure-random-secret-key-chithi-2026"

# 4. Optional / AI Studio default variables
GEMINI_API_KEY=""
APP_URL=""
